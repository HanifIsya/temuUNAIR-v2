# Normalize line endings: LF in the repository, native in the working tree for text files.
* text=auto eol=lf

# Shell scripts must stay LF (they run in Linux CI and Docker)
*.sh text eol=lf
*.bash text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.heic binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary

# Generated and lock files: keep LF, no diff noise
pnpm-lock.yaml text eol=lf -diff
*.lock.json text eol=lf

# Markdown: normalize but allow trailing spaces to be preserved for hard line breaks
*.md text eol=lf
