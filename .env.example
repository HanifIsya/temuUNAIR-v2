# TemuUNAIR environment contract (Blueprint §5A.12 / BE-11).
# Copy to .env and fill in. NEVER commit .env. Secrets are marked (SECRET).
# All values below are development defaults for docker compose (infra/docker-compose.yml).

# --- App ---
APP_BASE_URL=http://localhost:3000

# --- Database (Postgres 16 + pgvector + pg-boss) ---
DATABASE_URL=postgres://temuunair:temuunair@localhost:5432/temuunair

# --- Auth.js (DEC-001) ---
# openssl rand -base64 32
AUTH_SECRET=dev-only-change-me
AUTH_GOOGLE_ID=dev-google-client-id
AUTH_GOOGLE_SECRET=dev-google-client-secret
# SECRET csv of allowed email domains. CONFIRM real UNAIR domains with UNAIR DTI (DEC-001).
AUTH_ALLOWED_DOMAINS=unair.ac.id,student.unair.ac.id

# --- S3-compatible storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=temuunair-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/temuunair-dev

# --- ML service ---
ML_SERVICE_URL=http://localhost:8000
# SECRET shared token between worker and services/ml
ML_SERVICE_TOKEN=dev-ml-token
# stub | real — stub returns deterministic vectors for tests/E2E (FE-12)
ML_MODE=stub

# --- Email (Mailpit in dev) ---
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="TemuUNAIR <no-reply@temuunair.local>"

# --- Crypto ---
# SECRET 32-byte base64 key for AES-GCM field encryption of hint answers. openssl rand -base64 32
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktMzJieXRlLWtleS1jaGFuZ2UtbWU=

# --- Business rules (DEC-007) ---
REPORT_TTL_DAYS=90
CLAIM_TTL_HOURS=72
MATCH_THRESHOLD_STRONG=0.75
MATCH_THRESHOLD_POSSIBLE=0.55
RATE_LIMIT_ENABLED=true

# --- Ops ---
LOG_LEVEL=info
# Optional error reporting
SENTRY_DSN=

# --- Frontend (NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_MOCKING=disabled
NEXT_PUBLIC_APP_URL=http://localhost:3000
