{
  "name": "temuunair",
  "version": "0.0.0",
  "private": true,
  "description": "TemuUNAIR â€” lost-and-found platform for Universitas Airlangga",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:unit": "vitest run",
    "test:integration": "node scripts/checks/step.mjs test:integration",
    "test:contract": "node scripts/checks/step.mjs test:contract",
    "test:e2e": "node scripts/checks/step.mjs test:e2e",
    "contracts:build": "node scripts/checks/step.mjs contracts:build",
    "contracts:check": "node scripts/checks/step.mjs contracts:check",
    "contracts:lint": "node scripts/checks/step.mjs contracts:lint",
    "contracts:breaking": "node scripts/checks/step.mjs contracts:breaking",
    "db:check": "node scripts/checks/step.mjs db:check",
    "db:generate": "node scripts/checks/step.mjs db:generate",
    "db:migrate": "node scripts/checks/step.mjs db:migrate",
    "seed": "node scripts/checks/step.mjs seed",
    "build": "node scripts/checks/build.mjs",
    "audit": "pnpm audit --prod --audit-level=high",
    "dev": "node scripts/checks/dev.mjs",
    "dev:worker": "node scripts/checks/dev.mjs worker",
    "gate": "bash scripts/gate.sh quick",
    "gate:quick": "bash scripts/gate.sh quick",
    "gate:full": "bash scripts/gate.sh full",
    "backlog:build": "node scripts/backlog-index.mjs"
  },
  "devDependencies": {
    "@temuunair/config": "workspace:*",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "undici": "^6.27.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
