{
  "$comment": "PLACEHOLDER. Real file is generated by services/ml/scripts/export_openapi.py (TMU-ML-001) and replaces this one. Kept so tooling paths exist and reviewers see the intended shape.",
  "openapi": "3.1.0",
  "info": {
    "title": "TemuUNAIR ML service",
    "version": "1.0.0",
    "description": "Internal FastAPI service. See docs/04-contracts/backend/BE-06-ml-service-contract.md"
  },
  "servers": [{ "url": "http://localhost:8000" }],
  "components": {
    "securitySchemes": {
      "bearerMl": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "object", "additionalProperties": true },
              "requestId": { "type": "string" }
            }
          }
        }
      },
      "ImageAnalysisRequest": {
        "type": "object",
        "required": ["imageUrl"],
        "properties": {
          "imageUrl": { "type": "string", "format": "uri" },
          "options": {
            "type": "object",
            "properties": {
              "detect": { "type": "boolean", "default": true },
              "embed": { "type": "boolean", "default": true },
              "quality": { "type": "boolean", "default": true }
            }
          }
        }
      },
      "ImageAnalysis": {
        "type": "object",
        "required": ["modelVersions", "detections", "embedding", "categoryGuess", "quality", "sensitive"],
        "properties": {
          "modelVersions": { "type": "object", "additionalProperties": { "type": "string" } },
          "detections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "classId", "confidence", "bbox"],
              "properties": {
                "label": { "type": "string" },
                "classId": { "type": "integer" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "bbox": {
                  "type": "object",
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": { "type": "number" }, "y": { "type": "number" },
                    "w": { "type": "number" }, "h": { "type": "number" }
                  }
                }
              }
            }
          },
          "primaryObject": { "type": ["object", "null"] },
          "embedding": {
            "type": "object",
            "required": ["model", "dim", "vector", "source"],
            "properties": {
              "model": { "type": "string" },
              "dim": { "type": "integer", "enum": [512] },
              "vector": { "type": "array", "items": { "type": "number" } },
              "source": { "type": "string", "enum": ["crop", "full"] }
            }
          },
          "categoryGuess": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "score"],
              "properties": {
                "category": { "type": "string" },
                "score": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "quality": {
            "type": "object",
            "required": ["blur", "brightness", "width", "height", "usable"],
            "properties": {
              "blur": { "type": "number" },
              "brightness": { "type": "number" },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "usable": { "type": "boolean" }
            }
          },
          "sensitive": {
            "type": "object",
            "required": ["cardLikely"],
            "properties": { "cardLikely": { "type": "boolean" } }
          }
        }
      },
      "EmbedTextRequest": {
        "type": "object",
        "required": ["texts", "locale"],
        "properties": {
          "texts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
            }
          },
          "locale": { "type": "string", "enum": ["id", "en"] }
        }
      },
      "EmbedTextResponse": {
        "type": "object",
        "required": ["embeddings", "modelVersions"],
        "properties": {
          "embeddings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "clipText", "sentence"],
              "properties": {
                "id": { "type": "string" },
                "clipText": { "type": "array", "items": { "type": "number" } },
                "sentence": { "type": "array", "items": { "type": "number" } }
              }
            }
          },
          "modelVersions": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "ExtractAttributesRequest": {
        "type": "object",
        "required": ["title", "description", "locale"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "locale": { "type": "string", "enum": ["id", "en"] }
        }
      },
      "Attributes": {
        "type": "object",
        "required": ["normalized", "itemName", "colors", "features", "keywords"],
        "properties": {
          "normalized": { "type": "string" },
          "itemName": { "type": "string" },
          "category": { "type": ["object", "null"] },
          "colors": { "type": "array", "items": { "type": "string" } },
          "brand": { "type": ["string", "null"] },
          "material": { "type": ["string", "null"] },
          "features": { "type": "array", "items": { "type": "string" } },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "ML-HEALTH",
        "security": [],
        "responses": { "200": { "description": "alive" } }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ML-READY",
        "security": [],
        "responses": { "200": { "description": "readiness with model load state" } }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "ML-MODELS",
        "security": [{ "bearerMl": [] }],
        "responses": { "200": { "description": "models.lock.json contents" } }
      }
    },
    "/v1/analyze-image": {
      "post": {
        "operationId": "ML-ANALYZE-IMAGE",
        "security": [{ "bearerMl": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImageAnalysisRequest" } } }
        },
        "responses": {
          "200": {
            "description": "analysis",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImageAnalysis" } } }
          },
          "default": { "description": "error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/embed-text": {
      "post": {
        "operationId": "ML-EMBED-TEXT",
        "security": [{ "bearerMl": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmbedTextRequest" } } }
        },
        "responses": {
          "200": {
            "description": "embeddings",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmbedTextResponse" } } }
          },
          "default": { "description": "error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/v1/extract-attributes": {
      "post": {
        "operationId": "ML-EXTRACT-ATTRIBUTES",
        "security": [{ "bearerMl": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExtractAttributesRequest" } } }
        },
        "responses": {
          "200": {
            "description": "attributes",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Attributes" } } }
          },
          "default": { "description": "error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    }
  }
}
