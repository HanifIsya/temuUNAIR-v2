# pnpm settings (TMU-OPS-001).
#
# Supply-chain policy: dependency lifecycle scripts are allowlisted explicitly in
# `package.json` → `pnpm.onlyBuiltDependencies` (currently `esbuild`, required by Vitest).
# Anything not listed there does not run its install scripts.
#
# `enable-pre-post-scripts` keeps `pnpm run` pre/post hooks working for the workspace scripts
# defined in `package.json` (e.g. a future `prebuild`).
enable-pre-post-scripts=true

# The workspace resolves peers from its own packages, so an unmet optional peer should warn
# rather than block a fresh `pnpm install` on CI.
strict-peer-dependencies=false
auto-install-peers=true
