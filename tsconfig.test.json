{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": ["apps/web/src/**/*.test.ts", "apps/web/src/**/*.test.tsx"]
}
